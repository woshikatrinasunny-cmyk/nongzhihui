/* pages/collect/collect.wxss */page {
  background: #F5F5F0;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  background: transparent;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: white;
  border-radius: 50rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.08);
}

.search-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  color: #81C784;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2E7D32;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

/* Vant组件字体覆盖 */
.van-search__content, .van-field__control, .van-tag {
  font-family: 'FZXiaoBiaoSong-B05S', serif !important;
}

.clear-icon {
  font-size: 32rpx;
  margin-left: 12rpx;
  color: #9E9E9E;
}

.search-btn {
  margin-left: 20rpx;
  color: #2E7D32;
  font-size: 28rpx;
  font-weight: 500;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.search-history, .hot-search {
  padding: 0 24rpx 40rpx;
}

.history-header, .hot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.title-with-icon {
  display: flex;
  align-items: center;
}

.section-emoji {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.history-title, .hot-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2E7D32;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.clear-history {
  font-size: 24rpx;
  color: #81C784;
  padding: 8rpx 16rpx;
}

.history-tags, .hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.history-tag, .hot-tag {
  background: white;
  padding: 18rpx 32rpx;
  border-radius: 48rpx;
  font-size: 26rpx;
  color: #2E7D32;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.06);
  transition: all 0.3s;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.hot-tag {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  color: #2E7D32;
  font-weight: 500;
}

.search-results {
  padding: 0 24rpx 24rpx;
}

.result-count {
  font-size: 24rpx;
  color: #81C784;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-item {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.08);
  transition: all 0.3s;
}

.result-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 16rpx rgba(46, 125, 50, 0.15);
}

.result-title {
  font-size: 32rpx;
  color: #2E7D32;
  font-weight: bold;
  margin-bottom: 20rpx;
  line-height: 1.6;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.result-summary {
  font-size: 26rpx;
  color: #558B2F;
  line-height: 1.8;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9E9E9E;
}

.result-tag {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  color: #2E7D32;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  font-weight: 500;
}

.result-source {
  margin-right: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-emoji {
  font-size: 140rpx;
  margin-bottom: 32rpx;
  opacity: 0.4;
}

.empty-state text {
  font-size: 28rpx;
  color: #81C784;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #81C784;
  font-size: 28rpx;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

/* 收藏页特有布局微调 */
.container {
  padding: 24rpx; /* 为整个列表增加边距 */
  min-height: 100vh;
}
