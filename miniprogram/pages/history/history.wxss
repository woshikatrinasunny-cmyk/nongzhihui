/* pages/history/history.wxss */
page {
  background: #F5F5F0;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
}

.clear-btn {
  text-align: right;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.clear-btn text {
  color: #FF5722;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(255, 87, 34, 0.1);
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-item {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.08);
  transition: all 0.3s;
}

.result-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 16rpx rgba(46, 125, 50, 0.15);
}

.result-title {
  font-size: 32rpx;
  color: #2E7D32;
  font-weight: bold;
  margin-bottom: 20rpx;
  line-height: 1.6;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.result-summary {
  font-size: 26rpx;
  color: #558B2F;
  line-height: 1.8;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #9E9E9E;
}

.result-tag {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  color: #2E7D32;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.result-time {
  color: #9E9E9E;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-emoji {
  font-size: 140rpx;
  margin-bottom: 32rpx;
  opacity: 0.4;
}

.empty-state text {
  font-size: 28rpx;
  color: #81C784;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

