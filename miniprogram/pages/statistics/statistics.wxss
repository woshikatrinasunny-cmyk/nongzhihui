page {
  background: #F5F5F0;
}

.container {
  padding: 30rpx;
  min-height: 100vh;
}

.stats-header {
  margin-bottom: 30rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2E7D32;
  text-align: center;
}

.stats-cards {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #66BB6A 0%, #43A047 100%);
  border-radius: 20rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.2);
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2E7D32;
  margin-bottom: 20rpx;
}

.category-list {
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.08);
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-item:last-child {
  border-bottom: none;
}

.category-name {
  font-size: 28rpx;
  color: #333;
}

.category-count {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: bold;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-item {
  background: white;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.08);
}

.tag-name {
  font-size: 26rpx;
  color: #2E7D32;
}

.tag-count {
  font-size: 22rpx;
  color: #81C784;
  background: #E8F5E9;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.user-stats {
  display: flex;
  gap: 20rpx;
}

.user-stat-item {
  flex: 1;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.08);
}

.user-stat-icon {
  font-size: 60rpx;
}

.user-stat-info {
  flex: 1;
}

.user-stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #2E7D32;
  margin-bottom: 8rpx;
}

.user-stat-label {
  font-size: 24rpx;
  color: #999;
}
