page {
  background: #F5F5F0;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.user-card {
  background: linear-gradient(135deg, #2E7D32 0%, #43A047 100%);
  border-radius: 20rpx;
  padding: 56rpx 36rpx;
  margin: 24rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(46, 125, 50, 0.25);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  margin-right: 28rpx;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 38rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.menu-list {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 0 24rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-bottom: 2rpx solid rgba(46, 125, 50, 0.06);
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F5F5F0;
}

.menu-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #2E7D32;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.arrow-icon {
  font-size: 28rpx;
  color: #81C784;
}

.version-info {
  text-align: center;
  padding: 24rpx 0;
}

.version-info text {
  font-size: 24rpx;
  color: #81C784;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

/* Vant组件字体覆盖 */
.van-cell__title, .van-cell__value {
  font-family: 'FZXiaoBiaoSong-B05S', serif !important;
}

.login-arrow {
  font-size: 40rpx;
  color: white;
  font-weight: bold;
  margin-left: auto;
}

.logout-btn {
  background: rgba(255, 255, 255, 0.3);
  color: white;
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  line-height: 1;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  margin-left: auto;
}
