page {
  background: linear-gradient(180deg, #f8faf6 0%, #f0f4ec 100%);
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

/* ===== 主卡片 ===== */
.detail-card {
  background: white;
  border-radius: 0 0 32rpx 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.05);
}

.detail-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 元信息 */
.detail-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.meta-tag {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  color: #2E7D32;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.meta-source {
  font-size: 22rpx;
  color: #888;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.meta-time {
  font-size: 22rpx;
  color: #aaa;
}

/* 摘要 */
.detail-summary {
  background: linear-gradient(135deg, #f9fdf7 0%, #f0f7ec 100%);
  padding: 28rpx;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
  border-left: 6rpx solid #4CAF50;
}

.summary-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.summary-emoji { font-size: 24rpx; }

.summary-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.9;
}

/* 正文 */
.detail-content {
  font-size: 28rpx;
  color: #333;
  line-height: 2;
  margin-bottom: 32rpx;
}

/* 标签 */
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.tag-item {
  background: #f0f7f0;
  color: #4CAF50;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-item:active {
  background: #E8F5E9;
}

/* 来源提示 */
.source-tip {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  text-align: center;
}

.source-tip-text {
  font-size: 20rpx;
  color: #ccc;
}

/* ===== 操作栏 ===== */
.action-bar {
  display: flex;
  justify-content: space-around;
  background: white;
  border-radius: 24rpx;
  padding: 28rpx 0;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.2s;
}

.action-item:active { transform: scale(0.9); }

.action-emoji { font-size: 44rpx; }

.action-item text:last-child {
  font-size: 22rpx;
  color: #888;
}

/* ===== 相关推荐 ===== */
.related-section {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 0 24rpx 40rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.title-emoji { font-size: 28rpx; }

.related-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.related-item {
  padding: 20rpx;
  background: #fafcf8;
  border-radius: 16rpx;
  border-left: 4rpx solid #81C784;
  transition: all 0.2s;
}

.related-item:active {
  background: #f0f7ec;
}

.related-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.related-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.related-tag {
  font-size: 20rpx;
  color: #4CAF50;
  background: #e8f5e9;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.related-time {
  font-size: 20rpx;
  color: #bbb;
}

/* ===== 加载状态 ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  gap: 20rpx;
}

.loading-state text {
  color: #aaa;
  font-size: 28rpx;
}
