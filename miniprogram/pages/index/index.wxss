page {
  background: linear-gradient(180deg, #2E7D32 0%, #43A047 100%);
  min-height: 100vh;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.container {
  padding-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

/* 顶部导航栏 */
.top-bar {
  padding: 24rpx 32rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.app-title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  letter-spacing: 4rpx;
  margin-bottom: 4rpx;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.app-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

/* 搜索区域 */
.search-wrapper {
  padding: 16rpx 32rpx 32rpx;
}

/* 内容区域 - 半透明背景 */
.content-wrapper {
  background: rgba(245, 245, 240, 0.85);
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 0 0;
  min-height: calc(100vh - 240rpx);
  backdrop-filter: blur(10rpx);
}

/* 轮播图 */
.banner-wrapper {
  margin: 0 32rpx 48rpx;
}

.banner-swipe {
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.banner-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.15) 0%, transparent 70%);
}

.banner-content {
  z-index: 2;
}

.banner-title {
  font-size: 48rpx;
  font-weight: 500;
  color: white;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.banner-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
}

.banner-emoji {
  font-size: 120rpx;
  opacity: 0.2;
  position: absolute;
  right: 40rpx;
  bottom: 30rpx;
  filter: blur(2rpx);
}

/* 快捷入口 */
.grid-wrapper {
  margin: 0 32rpx 48rpx;
  background: white;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.08);
}

.grid-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.12);
  position: relative;
  overflow: hidden;
}

.grid-icon::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
}

.grid-emoji {
  font-size: 56rpx;
  position: relative;
  z-index: 1;
}

.grid-text {
  font-size: 28rpx !important;
  color: #2E7D32 !important;
  font-weight: 500;
  letter-spacing: 1rpx;
  font-family: 'FZXiaoBiaoSong-B05S', serif !important;
  line-height: 1.6 !important;
  margin-top: 8rpx;
}

/* Vant组件字体强制覆盖 */
.van-cell__title, .van-cell__label, .van-tag, .van-grid-item__text {
  font-family: 'FZXiaoBiaoSong-B05S', serif !important;
}

/* 列表区域 */
.section {
  margin: 0 32rpx 48rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #2E7D32;
  letter-spacing: 2rpx;
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

.cell-label {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.cell-time {
  font-size: 24rpx;
  color: #81C784;
  margin-left: 12rpx;
  letter-spacing: 0.5rpx;
}

/* ===== 资源卡片列表 ===== */
.resource-cards {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(44, 75, 64, 0.06);
}

.res-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: white;
  transition: all 0.2s;
  border-bottom: 1rpx solid #f5f5f5;
}

.res-card:last-child { border-bottom: none; }
.res-card:active { background: #fafcf8; }

.res-card-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.res-card-content {
  flex: 1;
  min-width: 0;
}

.res-card-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.5;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.res-card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.res-card-tag {
  font-size: 20rpx;
  color: #4CAF50;
  background: #f0f7f0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.res-card-source {
  font-size: 20rpx;
  color: #bbb;
}

.res-card-arrow {
  font-size: 36rpx;
  color: #ddd;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.res-empty {
  padding: 48rpx;
  text-align: center;
}

.res-empty text {
  font-size: 24rpx;
  color: #ccc;
}
