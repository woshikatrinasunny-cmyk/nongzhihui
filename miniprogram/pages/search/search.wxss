page {
  background: linear-gradient(180deg, #f8faf6 0%, #f0f4ec 100%);
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

/* ===== 搜索头部 ===== */
.search-header {
  background: white;
  padding-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.search-box {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f7f3;
  border-radius: 44rpx;
  padding: 20rpx 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.search-input-wrapper:focus-within {
  border-color: #4CAF50;
  background: white;
  box-shadow: 0 0 0 4rpx rgba(76, 175, 80, 0.1);
}

.search-icon { font-size: 32rpx; margin-right: 12rpx; }

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-icon {
  font-size: 28rpx;
  color: #ccc;
  padding: 8rpx;
}

.search-btn {
  margin-left: 20rpx;
  background: linear-gradient(135deg, #43A047, #66BB6A);
  color: white;
  font-size: 26rpx;
  font-weight: 600;
  padding: 20rpx 36rpx;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(67, 160, 71, 0.3);
}

.search-btn:active {
  transform: scale(0.95);
}

/* ===== 通用区块 ===== */
.section {
  margin: 24rpx;
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-emoji { font-size: 28rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; }
.section-action { font-size: 24rpx; color: #aaa; }

/* 历史标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  background: #f5f7f3;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #555;
  transition: all 0.2s;
}

.tag-item:active { background: #e8f5e9; color: #2E7D32; }

/* 热门搜索 */
.hot-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.2s;
}

.hot-item:last-child { border-bottom: none; }
.hot-item:active { background: #f9fdf7; }

.hot-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-top {
  background: linear-gradient(135deg, #FF6B35, #FF8F65);
  color: white;
}

.rank-normal {
  background: #f0f0f0;
  color: #999;
}

.hot-text {
  font-size: 28rpx;
  color: #333;
}

/* ===== 搜索结果 ===== */
.results-section {
  padding: 0 24rpx 24rpx;
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx;
}

.results-count { font-size: 24rpx; color: #888; }
.results-tip { font-size: 20rpx; color: #ccc; }

.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-card {
  background: white;
  border-radius: 20rpx;
  display: flex;
  overflow: hidden;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.05);
  transition: all 0.2s;
}

.result-card:active {
  transform: scale(0.985);
}

.result-accent {
  width: 6rpx;
  flex-shrink: 0;
}
.result-accent-law { background: linear-gradient(180deg, #1976D2, #64B5F6); }
.result-accent-policy { background: linear-gradient(180deg, #2E7D32, #81C784); }
.result-accent-tech { background: linear-gradient(180deg, #F57C00, #FFB74D); }
.result-accent-culture { background: linear-gradient(180deg, #7B1FA2, #CE93D8); }

.result-body {
  flex: 1;
  padding: 24rpx;
  min-width: 0;
}

.result-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.result-cat {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}
.result-cat-law { background: #E3F2FD; color: #1565C0; }
.result-cat-policy { background: #E8F5E9; color: #2E7D32; }
.result-cat-tech { background: #FFF3E0; color: #E65100; }
.result-cat-culture { background: #F3E5F5; color: #6A1B9A; }

.result-source {
  font-size: 20rpx;
  color: #bbb;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-title {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-summary {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-tags {
  display: flex;
  gap: 8rpx;
  flex: 1;
  overflow: hidden;
}

.result-tag {
  font-size: 20rpx;
  color: #4CAF50;
  background: #f0f7f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.result-time {
  font-size: 20rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.empty-emoji { font-size: 100rpx; margin-bottom: 20rpx; opacity: 0.4; }
.empty-text { font-size: 28rpx; color: #999; margin-bottom: 8rpx; }
.empty-sub { font-size: 22rpx; color: #ccc; }

/* ===== 加载动画 ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-dots {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #4CAF50;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot1 { animation-delay: -0.32s; }
.dot2 { animation-delay: -0.16s; }
.dot3 { animation-delay: 0s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.4); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}

.loading-text {
  font-size: 26rpx;
  color: #aaa;
}
