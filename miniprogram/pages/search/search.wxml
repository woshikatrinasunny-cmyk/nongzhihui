<view class="container">
  <!-- 搜索框 -->
  <view class="search-header">
    <view class="search-box">
      <view class="search-input-wrapper">
        <text class="search-icon">🔍</text>
        <input class="search-input" 
               placeholder="搜索涉农法律、政策、技术..." 
               value="{{keyword}}"
               bindinput="onInput"
               bindconfirm="onSearch"
               focus="{{autoFocus}}"
               placeholder-style="color: #aaa;"/>
        <text wx:if="{{keyword}}" class="clear-icon" bindtap="clearKeyword">✕</text>
      </view>
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
    <!-- 搜索联想词 -->
    <view class="suggestion-list" wx:if="{{suggestions.length > 0}}">
      <view class="suggestion-item" 
            wx:for="{{suggestions}}" 
            wx:key="index"
            bindtap="selectSuggestion"
            data-keyword="{{item}}">
        <text class="suggestion-icon">🔍</text>
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索历史 -->
  <view class="section" wx:if="{{!hasSearched && searchHistory.length > 0}}">
    <view class="section-header">
      <view class="section-title-row">
        <text class="section-emoji">🕒</text>
        <text class="section-title">搜索历史</text>
      </view>
      <text class="section-action" bindtap="clearHistory">清空</text>
    </view>
    <view class="tag-list">
      <view class="tag-item" 
            wx:for="{{searchHistory}}" 
            wx:key="index"
            bindtap="selectHistory"
            data-keyword="{{item}}">{{item}}</view>
    </view>
  </view>

  <!-- 热门搜索 -->
  <view class="section" wx:if="{{!hasSearched}}">
    <view class="section-header">
      <view class="section-title-row">
        <text class="section-emoji">🔥</text>
        <text class="section-title">热门搜索</text>
      </view>
    </view>
    <view class="hot-list">
      <view class="hot-item" 
            wx:for="{{hotKeywords}}" 
            wx:key="id"
            bindtap="selectHot"
            data-keyword="{{item.keyword}}">
        <text class="hot-rank rank-{{index < 3 ? 'top' : 'normal'}}">{{index + 1}}</text>
        <text class="hot-text">{{item.keyword}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="results-section" wx:if="{{hasSearched && searchResults.length > 0}}">
    <view class="results-header">
      <text class="results-count">找到 {{totalCount}} 条相关结果</text>
      <text class="results-tip">数据来自互联网</text>
    </view>
    <!-- 排序栏 -->
    <view class="sort-bar">
      <view class="sort-item {{filters.sortBy === 'relevance' ? 'active' : ''}}" bindtap="setSort" data-sort="relevance">综合</view>
      <view class="sort-item {{filters.sortBy === 'time' ? 'active' : ''}}" bindtap="setSort" data-sort="time">最新</view>
      <view class="sort-item {{filters.sortBy === 'authority' ? 'active' : ''}}" bindtap="setSort" data-sort="authority">权威</view>
      <view class="sort-item {{filters.sortBy === 'popularity' ? 'active' : ''}}" bindtap="setSort" data-sort="popularity">热度</view>
    </view>

    <view class="result-list">
      <view class="result-card" 
            wx:for="{{searchResults}}" 
            wx:key="_id"
            bindtap="viewDetail"
            data-id="{{item._id}}">
        <view class="result-accent result-accent-{{item.category}}"></view>
        <view class="result-body">
          <view class="result-top">
            <view class="result-cat result-cat-{{item.category}}">
              <text>{{item.category === 'law' ? '⚖️ 法律' : item.category === 'policy' ? '📋 政策' : item.category === 'tech' ? '🔬 技术' : '📖 文化'}}</text>
            </view>
            <text class="result-source" wx:if="{{item.source}}">{{item.source}}</text>
          </view>
          <view class="result-title">{{item.title}}</view>
          <view class="result-summary" wx:if="{{item.summary}}">{{item.summary}}</view>
          <view class="result-bottom">
            <view class="result-tags" wx:if="{{item.tags && item.tags.length > 0}}">
              <text class="result-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" wx:if="{{index < 2}}">{{tag}}</text>
            </view>
            <text class="result-time" wx:if="{{item.publishTime}}">{{item.publishTime}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{hasSearched && searchResults.length === 0 && !loading}}">
    <text class="empty-emoji">🔍</text>
    <text class="empty-text">未找到相关结果</text>
    <text class="empty-sub">换个关键词试试</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-dots">
      <view class="dot dot1"></view>
      <view class="dot dot2"></view>
      <view class="dot dot3"></view>
    </view>
    <text class="loading-text">正在搜索全网资源...</text>
  </view>

  <!-- 筛选面板 -->
  <filter-panel 
    show="{{showFilter}}"
    filters="{{filters}}"
    bind:confirm="onFilterConfirm"
    bind:close="onFilterClose">
  </filter-panel>
</view>
