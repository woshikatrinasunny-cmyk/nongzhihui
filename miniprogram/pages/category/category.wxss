page {
  background: linear-gradient(180deg, #f8faf6 0%, #f0f4ec 100%);
  font-family: 'FZXiaoBiaoSong-B05S', serif;
}

/* ===== 分类导航 ===== */
.category-nav {
  padding: 28rpx 0 20rpx;
  background: white;
  box-shadow: 0 4rpx 24rpx rgba(46, 125, 50, 0.06);
}

.category-grid {
  display: flex;
  justify-content: space-around;
  padding: 0 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 12rpx;
  position: relative;
  transition: all 0.3s;
}

.category-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
  transition: all 0.3s;
}

.category-item.active .category-icon {
  transform: scale(1.12);
  box-shadow: 0 8rpx 28rpx rgba(46, 125, 50, 0.25);
}

.category-emoji { font-size: 44rpx; }

.category-name {
  font-size: 26rpx;
  color: #888;
  transition: all 0.3s;
  white-space: nowrap;
}

.category-item.active .category-name {
  color: #2E7D32;
  font-weight: bold;
}

.category-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #4CAF50;
  margin-top: 8rpx;
}

/* ===== 资源卡片 ===== */
.resource-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.resource-card {
  background: white;
  border-radius: 24rpx;
  display: flex;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(46, 125, 50, 0.07);
  position: relative;
  transition: all 0.2s;
}

.resource-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 16rpx rgba(46, 125, 50, 0.12);
}

/* 左侧色条 */
.card-accent {
  width: 8rpx;
  flex-shrink: 0;
}
.card-accent-law { background: linear-gradient(180deg, #1976D2, #42A5F5); }
.card-accent-policy { background: linear-gradient(180deg, #2E7D32, #66BB6A); }
.card-accent-tech { background: linear-gradient(180deg, #F57C00, #FFB74D); }
.card-accent-culture { background: linear-gradient(180deg, #7B1FA2, #BA68C8); }

.card-body {
  flex: 1;
  padding: 28rpx 24rpx;
  min-width: 0;
}

/* 顶部 */
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-category {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  gap: 6rpx;
}
.card-cat-law { background: #E3F2FD; }
.card-cat-policy { background: #E8F5E9; }
.card-cat-tech { background: #FFF3E0; }
.card-cat-culture { background: #F3E5F5; }

.card-cat-emoji { font-size: 22rpx; }
.card-cat-text { font-size: 20rpx; font-weight: 600; color: #555; }

.card-source {
  font-size: 20rpx;
  color: #aaa;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 标题 */
.card-title {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 摘要 */
.card-summary {
  font-size: 24rpx;
  color: #888;
  line-height: 1.7;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 底部 */
.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-tags {
  display: flex;
  gap: 10rpx;
  flex: 1;
  overflow: hidden;
}

.card-tag {
  font-size: 20rpx;
  color: #4CAF50;
  background: #f0f7f0;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.card-time {
  font-size: 20rpx;
  color: #bbb;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 右侧装饰 */
.card-deco {
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.06;
}
.card-deco-emoji { font-size: 80rpx; }

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 48rpx;
  gap: 20rpx;
}
.load-more-line {
  flex: 1;
  height: 1rpx;
  background: #ddd;
}
.load-more-text {
  font-size: 22rpx;
  color: #bbb;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.empty-emoji { font-size: 120rpx; margin-bottom: 24rpx; opacity: 0.5; }
.empty-text { font-size: 28rpx; color: #999; margin-bottom: 12rpx; }
.empty-sub { font-size: 22rpx; color: #ccc; }
