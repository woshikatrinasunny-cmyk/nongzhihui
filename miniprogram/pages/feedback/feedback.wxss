page { background: #F5F5F0; }

.container { padding: 30rpx; }

.feedback-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.05);
}

.label {
  font-size: 28rpx;
  color: #2E7D32;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.content-input {
  width: 100%;
  height: 300rpx;
  font-size: 28rpx;
  color: #333;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.contact-input {
  font-size: 28rpx;
  color: #333;
}

.submit-btn {
  background: #4CAF50;
  color: white;
  border-radius: 50rpx;
  margin-top: 50rpx;
  font-weight: bold;
}